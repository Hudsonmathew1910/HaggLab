# Copy to .env for local runs. On the server, set the same names in the hosting panel.
# Only names and safe defaults belong here, never real values.

# Live site only: set DJANGO_SETTINGS_MODULE=config.settings.prod in the hosting panel's environment.
# It is not read from this file; locally manage.py already uses config.settings.dev.

# Security & Environment
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=
SITE_URL=
ADMIN_URL_PATH=

# Database (PostgreSQL / Neon). Leave NEON_DB_HOST empty locally to use db.sqlite3
NEON_DB_NAME=
NEON_DB_USER=
NEON_DB_PASSWORD=
NEON_DB_HOST=
NEON_DB_PORT=5432

# Inquiry email alerts (Gmail SMTP: smtp.gmail.com, port 587, TLS, an App Password)
OWNER_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Cloudflare Turnstile spam check on the contact form (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI providers for the Try it pages. Order: Gemini 1 -> Hero 1 -> Gemini 2 -> Hero 2 -> Hero 3
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
HEROS_API_URL=https://hero-s-ai.alwaysdata.net/api/v1
HEROS_API_KEY_1=
HEROS_API_KEY_2=
HEROS_API_KEY_3=
HEROS_MODEL=baymax-4.5

# Pinecone vector database (RAG). The index embeds the text itself (integrated embedding).
PINECONE_API_KEY=
PINECONE_INDEX=hagglab-db

# Site-wide AI calls per day (default 300; 0 = no limit)
AI_DAILY_CAP=300
